RESEARCHER_PROMPT = """
You are the Researcher Agent in a multi-agent research workflow.

Your task is to gather reliable, relevant, and verifiable evidence for the
research question you receive.

Rules:
1. Use search_web to search for reliable sources.
2. Use read_webpage to inspect important source pages before making conclusions.
3. Prefer primary sources, official documentation, academic papers, and
   reputable institutions.
4. Never invent facts, statistics, citations, URLs, or source content.
5. If a search fails or gives no useful results, try a different search
   strategy rather than repeating the same failed request.
6. Clearly separate verified facts from uncertainty.
7. Gather evidence that another agent can analyze.
8. For every important claim, include the source title and URL.
9. Keep the research notes concise and structured.

End your response with:
- Key findings
- Supporting evidence
- Source links
- Uncertainties or limitations
"""


ANALYST_PROMPT = """
You are the Analyst Agent in a multi-agent research workflow.

You receive research notes collected from independent research passes.

Produce a concise, structured analysis that:

1. Identifies the main findings.
2. Compares evidence from the different research passes.
3. Identifies agreements and contradictions.
4. Separates facts from interpretation.
5. Identifies important limitations and missing evidence.
6. Preserves source URLs when they support a claim.
7. Does not browse the web.
8. Does not invent facts, citations, URLs, or evidence.

Use clear headings and concise reasoning.

End with a section titled:

Evidence gaps
"""


WRITER_PROMPT = """
You are the Writer Agent in a multi-agent research workflow.

Turn the supplied research notes, analysis, and fact-check results into a
clear, accurate, beginner-friendly final report.

Requirements:
1. Answer the original research question directly.
2. Use a descriptive title and clear headings.
3. Explain important terms before using them.
4. Base claims only on the supplied evidence.
5. Preserve useful source URLs.
6. Never invent facts, citations, statistics, or URLs.
7. Clearly mention uncertainty, limitations, and evidence gaps.
8. If the fact checker reports FAIL or unresolved evidence remains, explicitly
   mention the limitation instead of hiding it.
9. End with a concise conclusion.
10. Include a final Sources section with the relevant URLs.

The report should be balanced, readable, and evidence-based.
"""


# ============================================================
# TODO #2 — BUILD THE AGENTS
# Paste this part into the TODO #2 cell
# ============================================================

researcher = create_agent(
    model=llm,
    tools=RESEARCH_TOOLS,
    system_prompt=RESEARCHER_PROMPT,
    middleware=[
        ToolCallLimitMiddleware(
            thread_limit=10,
            exit_behavior='end'
        )
    ],
)

analyst = create_agent(
    model=llm,
    tools=[],
    system_prompt=ANALYST_PROMPT,
)

writer = create_agent(
    model=llm,
    tools=[],
    system_prompt=WRITER_PROMPT,
)

# Extra planning agent for query decomposition.
planner = create_agent(
    model=llm,
    tools=[],
    system_prompt=(
        "You are the Planning Agent in a multi-agent research workflow. "
        "Decompose the user's research question into exactly two complementary "
        "research questions that can be investigated independently. "
        "Return exactly two lines, one question per line, with no numbering "
        "and no additional explanation."
    ),
)

# Fact-checking agent for quality control.
fact_checker = create_agent(
    model=llm,
    tools=[],
    system_prompt=(
        "You are a strict Fact-Checker Agent in a multi-agent research workflow. "
        "Review the supplied research notes, analysis, and source links. "
        "Look for unsupported claims, contradictions, missing evidence, "
        "incorrect reasoning, and conclusions that go beyond the evidence. "
        "Be conservative: when important evidence is incomplete, fail the check. "
        "At the end of your response, return exactly one final line: "
        "VERDICT: PASS or VERDICT: FAIL."
    ),
)


# ============================================================
# TODO #3 — MULTI-AGENT LANGGRAPH PIPELINE
# Paste this part into the TODO #3 cell
# ============================================================

async def run_pipeline(query: str) -> dict:
    assert (
        researcher is not None
        and analyst is not None
        and writer is not None
        and planner is not None
        and fact_checker is not None
    ), "finish TODO #2 first"

    from typing import Annotated
    import operator
    import re

    # --------------------------------------------------------
    # Reliability limits
    # --------------------------------------------------------
    MAX_RETRIES = 2
    MAX_STEPS = 20

    detector = LoopDetector()

    # --------------------------------------------------------
    # Shared graph state
    #
    # Reducers are required because researcher_a and
    # researcher_b execute in parallel.
    # --------------------------------------------------------
    class PipelineState(TypedDict):
        query: str
        report: str

        sub_queries: list[str]

        research_results: Annotated[list[str], operator.add]

        research_notes: str
        analysis: str

        fact_check: str
        fact_check_passed: bool

        retry_count: int

        step_count: Annotated[int, operator.add]
        loop_warnings: Annotated[list[str], operator.add]

    # --------------------------------------------------------
    # 1. Planner
    # --------------------------------------------------------
    async def planner_node(state: PipelineState) -> dict:
        result = await run_agent(
            planner,
            (
                f"Original research question:\n{state['query']}\n\n"
                "Split the question into exactly two complementary "
                "research questions."
            ),
            5,
        )

        lines = [
            line.strip()
            for line in result["answer"].splitlines()
            if line.strip()
        ]

        # Remove numbering such as 1. / 2) / 1-
        cleaned_lines = [
            re.sub(r"^\d+[\).\s-]+", "", line).strip()
            for line in lines
        ]

        # Safe fallback if planner does not provide 2 questions.
        if len(cleaned_lines) < 2:
            cleaned_lines = [
                state["query"],
                (
                    f"{state['query']} - evidence, limitations, "
                    "and practical implications"
                ),
            ]

        return {
            "sub_queries": cleaned_lines[:2],
            "step_count": 1,
            "loop_warnings": [],
        }

    # --------------------------------------------------------
    # 2A. Researcher A
    # --------------------------------------------------------
    async def researcher_a_node(state: PipelineState) -> dict:
        sub_query = state["sub_queries"][0]

        check = detector.check_tool_call(
            "research_branch_a",
            sub_query,
        )

        warnings = [check.message] if check.is_looping else []

        result = await run_agent(
            researcher,
            (
                f"Research question:\n{sub_query}\n\n"
                "Use search_web and read_webpage. "
                "Find multiple reliable sources, inspect important pages, "
                "and provide source URLs."
            ),
            10,
        )

        stagnation = detector.check_output_stagnation(
            result["answer"]
        )

        if stagnation.is_looping:
            warnings.append(stagnation.message)

        return {
            "research_results": [
                "RESEARCH PASS A\n" + result["answer"]
            ],
            "step_count": 1,
            "loop_warnings": warnings,
        }

    # --------------------------------------------------------
    # 2B. Researcher B
    # --------------------------------------------------------
    async def researcher_b_node(state: PipelineState) -> dict:
        sub_query = state["sub_queries"][1]

        check = detector.check_tool_call(
            "research_branch_b",
            sub_query,
        )

        warnings = [check.message] if check.is_looping else []

        result = await run_agent(
            researcher,
            (
                f"Research question:\n{sub_query}\n\n"
                "Use a different search strategy from Research Pass A. "
                "Find reliable and preferably independent sources. "
                "Verify important claims and provide source URLs."
            ),
            10,
        )

        stagnation = detector.check_output_stagnation(
            result["answer"]
        )

        if stagnation.is_looping:
            warnings.append(stagnation.message)

        return {
            "research_results": [
                "RESEARCH PASS B\n" + result["answer"]
            ],
            "step_count": 1,
            "loop_warnings": warnings,
        }

    # --------------------------------------------------------
    # 3. Combine parallel research results
    # --------------------------------------------------------
    async def combine_research_node(state: PipelineState) -> dict:
        combined_notes = (
            "\n\n====================\n\n"
            .join(state["research_results"])
        )

        return {
            "research_notes": combined_notes,
            "step_count": 1,
            "loop_warnings": [],
        }

    # --------------------------------------------------------
    # 4. Analyst
    # --------------------------------------------------------
    async def analyst_node(state: PipelineState) -> dict:
        result = await run_agent(
            analyst,
            (
                f"Original question:\n{state['query']}\n\n"
                f"Research notes:\n{state['research_notes']}\n\n"
                "Compare the research results and produce a concise "
                "evidence-based analysis."
            ),
            10,
        )

        stagnation = detector.check_output_stagnation(
            result["answer"]
        )

        warnings = [stagnation.message] if stagnation.is_looping else []

        return {
            "analysis": result["answer"],
            "step_count": 1,
            "loop_warnings": warnings,
        }

    # --------------------------------------------------------
    # 5. Fact Checker
    # --------------------------------------------------------
    async def fact_checker_node(state: PipelineState) -> dict:
        result = await run_agent(
            fact_checker,
            (
                f"Original question:\n{state['query']}\n\n"
                f"Research:\n{state['research_notes']}\n\n"
                f"Analysis:\n{state['analysis']}\n\n"
                "Check all important claims. Look for unsupported "
                "statements, contradictions, missing evidence, and "
                "overclaims. End with exactly one final line: "
                "VERDICT: PASS or VERDICT: FAIL."
            ),
            8,
        )

        passed = "VERDICT: PASS" in result["answer"].upper()

        stagnation = detector.check_output_stagnation(
            result["answer"]
        )

        warnings = [stagnation.message] if stagnation.is_looping else []

        # Do not accept a stagnant fact-check result.
        if stagnation.is_looping:
            passed = False

        return {
            "fact_check": result["answer"],
            "fact_check_passed": passed,
            "step_count": 1,
            "loop_warnings": warnings,
        }

    # --------------------------------------------------------
    # 6. Retry Research
    # --------------------------------------------------------
    async def retry_research_node(state: PipelineState) -> dict:
        retry_number = state["retry_count"] + 1

        check = detector.check_tool_call(
            "research_retry",
            f"{state['query']} retry {retry_number}",
        )

        warnings = [check.message] if check.is_looping else []

        result = await run_agent(
            researcher,
            (
                f"Original question:\n{state['query']}\n\n"
                f"Previous research:\n{state['research_notes']}\n\n"
                f"Previous analysis:\n{state['analysis']}\n\n"
                f"Fact-check result:\n{state['fact_check']}\n\n"
                "The fact checker was not satisfied. "
                "Perform a new research pass. "
                "Do NOT repeat the previous research strategy. "
                "Find stronger, newer, or independent evidence. "
                "Verify important claims and provide source URLs."
            ),
            10,
        )

        stagnation = detector.check_output_stagnation(
            result["answer"]
        )

        if stagnation.is_looping:
            warnings.append(stagnation.message)

        updated_notes = (
            state["research_notes"]
            + "\n\n================ RETRY RESEARCH ================\n\n"
            + result["answer"]
        )

        return {
            "research_notes": updated_notes,
            "retry_count": retry_number,
            "step_count": 1,
            "loop_warnings": warnings,
        }

    # --------------------------------------------------------
    # 7. Re-analysis
    # --------------------------------------------------------
    async def reanalysis_node(state: PipelineState) -> dict:
        result = await run_agent(
            analyst,
            (
                f"Original question:\n{state['query']}\n\n"
                f"Updated research:\n{state['research_notes']}\n\n"
                f"Previous fact-check:\n{state['fact_check']}\n\n"
                "Re-analyze the updated evidence. "
                "Correct unsupported claims and strengthen the analysis."
            ),
            10,
        )

        stagnation = detector.check_output_stagnation(
            result["answer"]
        )

        warnings = [stagnation.message] if stagnation.is_looping else []

        return {
            "analysis": result["answer"],
            "step_count": 1,
            "loop_warnings": warnings,
        }

    # --------------------------------------------------------
    # 8. Writer
    # --------------------------------------------------------
    async def writer_node(state: PipelineState) -> dict:
        result = await run_agent(
            writer,
            (
                f"Original question:\n{state['query']}\n\n"
                f"Research notes:\n{state['research_notes']}\n\n"
                f"Analysis:\n{state['analysis']}\n\n"
                f"Fact-check:\n{state['fact_check']}\n\n"
                "Write the final report using only the supplied evidence."
            ),
            10,
        )

        return {
            "report": result["answer"],
            "step_count": 1,
            "loop_warnings": [],
        }

    # --------------------------------------------------------
    # Conditional router
    # --------------------------------------------------------
    def route_after_fact_check(state: PipelineState) -> str:
        # Quality check passed.
        if state["fact_check_passed"]:
            return "writer"

        # Prevent infinite loops.
        if state["retry_count"] >= MAX_RETRIES:
            return "writer"

        if state["step_count"] >= MAX_STEPS:
            return "writer"

        # Try new research.
        return "retry_research"

    # --------------------------------------------------------
    # Build graph
    # --------------------------------------------------------
    graph = StateGraph(PipelineState)

    graph.add_node("planner", planner_node)

    graph.add_node("researcher_a", researcher_a_node)
    graph.add_node("researcher_b", researcher_b_node)

    graph.add_node("combine_research", combine_research_node)

    graph.add_node("analyst", analyst_node)
    graph.add_node("fact_checker", fact_checker_node)

    graph.add_node("retry_research", retry_research_node)
    graph.add_node("reanalysis", reanalysis_node)

    graph.add_node("writer", writer_node)

    # START -> Planner
    graph.add_edge(START, "planner")

    # Planner -> parallel research branches
    graph.add_edge("planner", "researcher_a")
    graph.add_edge("planner", "researcher_b")

    # Parallel branches -> combine
    graph.add_edge("researcher_a", "combine_research")
    graph.add_edge("researcher_b", "combine_research")

    # Research -> analysis -> fact checking
    graph.add_edge("combine_research", "analyst")
    graph.add_edge("analyst", "fact_checker")

    # Conditional quality gate
    graph.add_conditional_edges(
        "fact_checker",
        route_after_fact_check,
        {
            "writer": "writer",
            "retry_research": "retry_research",
        },
    )

    # Retry loop
    graph.add_edge("retry_research", "reanalysis")
    graph.add_edge("reanalysis", "fact_checker")

    # Final output
    graph.add_edge("writer", END)

    # Compile
    pipeline = graph.compile()

    # --------------------------------------------------------
    # Initial state
    # --------------------------------------------------------
    initial_state: PipelineState = {
        "query": query,
        "report": "",
        "sub_queries": [],
        "research_results": [],
        "research_notes": "",
        "analysis": "",
        "fact_check": "",
        "fact_check_passed": False,
        "retry_count": 0,
        "step_count": 0,
        "loop_warnings": [],
    }

    # --------------------------------------------------------
    # Execute
    # --------------------------------------------------------
    result = await pipeline.ainvoke(initial_state)

    # Visible reaction for repetition/stagnation.
    if result.get("loop_warnings"):
        print("\n" + "=" * 60)
        print("LOOP / STAGNATION WARNINGS")
        print("=" * 60)

        for warning in result["loop_warnings"]:
            print("-", warning)

    # --------------------------------------------------------
    # Final output
    # --------------------------------------------------------
    return {
        "answer": result["report"],
        "metadata": {
            "graph_nodes": 9,
            "architecture": (
                "planner + parallel research + analyst "
                "+ fact-check retry loop"
            ),
            "executed_retries": result["retry_count"],
            "steps": result["step_count"],
            "fact_check_passed": result["fact_check_passed"],
            "loop_warnings": len(result["loop_warnings"]),
        },
    }
